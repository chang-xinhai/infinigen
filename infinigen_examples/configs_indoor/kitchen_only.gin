# Kitchen-only configuration for Infinigen indoor scene generation
# This config generates a single kitchen room with full object placement and optimization

# Base settings from singleroom.gin
BlueprintSolidifier.enable_open=False
restrict_solving.solve_max_rooms=3

# Base settings from fast_solve.gin
FloorPlanSolver.n_divide_trials = 25
FloorPlanSolver.iters_mult = 25
solve_objects.addition_weight_scalar = 3.0
compose_indoors.solve_steps_large = 100
compose_indoors.solve_steps_medium = 40
compose_indoors.solve_steps_small = 5

# Use kitchen_only mode - this is our custom approach
home_room_constraints.kitchen_only = True
home_room_constraints.has_fewer_rooms = False
home_furniture_constraints.kitchen_only = True

# Disable terrain to avoid errors
compose_indoors.terrain_enabled = False

# Increase kitchen size constraints for better counter/island placement
# Override the area constraint parameters to encourage larger kitchens
sample_home_constraint_params.furniture_fullness_pct = 0.9
sample_home_constraint_params.has_kitchen_barstools = True
