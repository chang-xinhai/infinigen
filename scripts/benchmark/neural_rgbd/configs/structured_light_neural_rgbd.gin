# Neural RGB-D benchmark structured-light tuning.
#
# These overrides are intentionally benchmark-local so the main Infinigen
# structured-light defaults remain unchanged. Neural RGB-D scenes often have
# different room scale and camera framing, so the projector usually needs a
# slightly wider cone to keep the pattern visible across the whole frame.
# Keep this file as the single benchmark-local tuning entry point.
#
# Infinigen indoor defaults:
#   sl_proj_fov_delta_deg = -5.0
#   sl_proj_energy = 1000.0
#
# Neural RGB-D benchmark defaults:
#   sl_proj_fov_delta_deg = 10.0
#   sl_proj_energy = 1200.0
#
# Suggested manual tuning:
#   - If the pattern is only a bit too dim, try 1300.0 first.
#   - If it starts to wash out highlights, go back toward 1100.0.

render_structured_light.sl_proj_fov_delta_deg = 10.0
render_structured_light.sl_proj_energy = 1200.0
